# --- Database ---
# Local/dev default matches docker-compose. The psycopg (v3) driver is required.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/code_review

# --- GitHub ---
# Personal access token (repo scope) used to read PR files and post reviews.
GITHUB_TOKEN=your_github_token_here
# Shared secret configured on the GitHub webhook; used to verify X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=change_me

# --- LLM ---
# Any host containing localhost/127.0.0.1 uses the Ollama client; otherwise an
# OpenAI-compatible endpoint is used and LLM_API_KEY is sent as a Bearer token.
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3
LLM_API_KEY=

# --- Dashboard ---
# Base URL the Streamlit dashboard uses to reach the API.
API_URL=http://localhost:8000
